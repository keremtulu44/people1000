# People1000 — canlı API ayar şablonu (31 Ekim 2026)
# Bu dosyada GERÇEK anahtar yoktur ve olmamalıdır. Repo dışına kopyalayın:
#   mkdir -p "$HOME/.config/people1000"
#   cp .env.example "$HOME/.config/people1000/api.env"
#   chmod 600 "$HOME/.config/people1000/api.env"
# Ardından yalnızca ilgili satırları doldurup yorum işaretini kaldırın.
# Dosyayı sohbete/ekran görüntüsüne/repo'ya koymayın.

# ─── 1) ApiWrapper (OpenAI uyumlu kendi servisiniz) — ÖNERİLEN ──────────────
# Adresin sonundaki / işareti kaldırılır ve /v1 eklenir; istekler
# <WRAPPER_URL>/v1/chat/completions adresine gider. Her istek bağımsızdır:
# sohbet geçmişi, veritabanı, oturum yeniden kullanımı veya developer mode
# yoktur. model=max, stream=false, zaman aşımı 180 sn, tek user mesajı.
# Anahtar yalnızca sunucu sürecinde kalır; tarayıcıya/repoya/loga yazılmaz.
# Değerler yalnızca placeholders'dır; gerçek adres/anahtarı buraya yazmayın.
# export WRAPPER_URL='https://api-wrapper.example.com'
# export WRAPPER_API_KEY='BURAYA_WRAPPER_ANAHTARI'

# ─── 2) Gemini doğrudan bağlantı (isteğe bağlı, eski/alternatif yol) ──────────
# WRAPPER_URL boşsa bu ayarlar kullanılır. Gemini 3.5 Flash-Lite: ücretsiz
# katmanda girdi ve çıktı "Free of charge". Sabit (pinned) kararlı model
# kimliği; gemini-flash-latest gibi her sürümde değişen kayan takma ad DEĞİLDİR.
# Adresteki model ile bu satır aynı olmalıdır.
# Bu iki satırı birlikte silerseniz adaptör kod sabitlerini kullanır; burada
# açıkça yazılmaları hangi modelin yüklendiğini `ayar` ile görmeyi kolaylaştırır.
export PEOPLE1000_API_ENDPOINT='https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent'
export PEOPLE1000_API_MODEL='gemini-3.5-flash-lite'

# export PEOPLE1000_API_KEY='BURAYA_AI_STUDIO_ANAHTARI'

# Ücretsiz kotadaki dakikalık hız sınırı (RPM) için istekler arası en az 6 sn.
# Kotanızı AI Studio → Rate limit sayfasından doğrulayın (proje bazlıdır).
export PEOPLE1000_API_MIN_INTERVAL=6
# 6 kitleli uzun Türkçe zincir yanıtlarının kesilmemesi için çıktı tavanı.
export PEOPLE1000_MAX_OUTPUT_TOKENS=4096
export PEOPLE1000_API_TIMEOUT=30
