# People1000 — canlı API ayar şablonu (26 Ekim 2026)
# Bu dosyada GERÇEK anahtar yoktur ve olmamalıdır. Repo dışına kopyalayın:
#   mkdir -p "$HOME/.config/people1000"
#   cp .env.example "$HOME/.config/people1000/api.env"
#   chmod 600 "$HOME/.config/people1000/api.env"
# Ardından yalnızca PEOPLE1000_API_KEY satırını AI Studio anahtarınızla doldurup
# yorum işaretini kaldırın. Dosyayı sohbete/ekran görüntüsüne/repo'ya koymayın.

# Gemini 3.5 Flash-Lite: ücretsiz katmanda girdi ve çıktı "Free of charge".
# Sabit (pinned) kararlı model kimliği; gemini-flash-latest gibi her sürümde
# değişen kayan takma ad DEĞİLDİR. Adresteki model ile bu satır aynı olmalı.
# Bu iki satırı birlikte silerseniz adaptör kod sabitlerini kullanır; burada
# açıkça yazılmaları hangi modelin yüklendiğini `ayar` ile görmeyi kolaylaştırır.
export PEOPLE1000_API_ENDPOINT='https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent'
export PEOPLE1000_API_MODEL='gemini-3.5-flash-lite'

# export PEOPLE1000_API_KEY='BURAYA_AI_STUDIO_ANAHTARI'

# Ücretsiz kotadaki dakikalık hız sınırı (RPM) için istekler arası en az 6 sn.
# Kotanızı AI Studio → Rate limit sayfasından doğrulayın (proje bazlıdır).
export PEOPLE1000_API_MIN_INTERVAL=6
# 6 kitleli uzun Türkçe zincir yanıtlarının kesilmemesi için çıktı tavanı.
export PEOPLE1000_MAX_OUTPUT_TOKENS=4096
export PEOPLE1000_API_TIMEOUT=30
